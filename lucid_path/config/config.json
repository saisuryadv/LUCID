{
  "model_type": "lucid_path_attn",
  "architectures": ["LucidPaTHAttentionForCausalLM"],
  "transformers_version": "4.54.0.dev0",
  "torch_dtype": "float32",
  "hidden_size": 2048,
  "num_hidden_layers": 22,
  "num_heads": 32,
  "num_kv_heads": 4,
  "intermediate_size": 5632,
  "hidden_act": "swish",
  "initializer_range": 0.02,
  "elementwise_affine": true,
  "norm_eps": 1e-5,
  "use_cache": false,
  "bos_token_id": 1,
  "eos_token_id": 2,
  "tie_word_embeddings": false,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "use_l2warp": false,
  "vocab_size": 32000,
  "use_forget_gate": false,
  "use_w_shortconv": false,
  "use_low_rank_w": false
}
